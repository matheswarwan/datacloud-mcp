{
  "name": "salesforce-datacloud-mcp",
  "version": "0.4.0",
  "description": "MCP server for Salesforce Data Cloud (Data 360) — explore DMOs, data streams, segments, and calculated insights through natural language",
  "main": "dist/index.js",
  "bin": {
    "salesforce-datacloud-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "mcp",
    "salesforce",
    "data-cloud",
    "data360",
    "modelcontextprotocol",
    "claude",
    "ai"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/http_server.js",
    "dev": "ts-node src/index.ts",
    "dev:http": "ts-node src/http_server.ts",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "wrangler": "^4.81.1"
  }
}
